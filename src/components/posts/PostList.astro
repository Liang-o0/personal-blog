---
import type { CollectionEntry } from 'astro:content';
import PostRows from './PostRows.vue';
import { summarizePost } from '../../lib/post-summary';
interface Props {
  posts: CollectionEntry<'posts'>[];
  seriesById?: Map<string, CollectionEntry<'series'>>;
  numbered?: boolean;
  offset?: number;
  tagsPlacement?: 'summary' | 'date';
}
const { posts, seriesById, ...presentation } = Astro.props;
const summaries = posts.map(post => summarizePost(post, post.data.series && seriesById?.get(post.data.series.id)?.data.title));
---
<PostRows posts={summaries} {...presentation} />
