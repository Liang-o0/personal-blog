---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesBrowser from './SeriesBrowser.vue';
import SlideButton from '../ui/SlideButton.vue';
import { getPostIndex, seriesUrl, type SeriesPage } from '../../lib/posts';
import { summarizePost } from '../../lib/post-summary';
import '../../styles/posts.css';
interface Props { directory: SeriesPage }
const { directory: { series, page, pageSize, pageCount } } = Astro.props;
const index = await getPostIndex();
const summaries = index.getSeriesPosts(series.id).map(post => summarizePost(post));
---
<BaseLayout title={`${series.data.title}${page > 1 ? ` · 第 ${page} 页` : ''}`} description={series.data.description}>
  <header class="archive-heading series-heading">
    <div class="series-back-action">
      <SlideButton text1="返回文章" text2="查看全部" href="/posts" arrowDirection="left" label="返回全部文章" />
    </div>
    <p class="eyebrow">Reading / Series</p>
    <h1>{series.data.title}<span>.</span></h1>
    <p class="muted">{series.data.description}</p>
  </header>
  <SeriesBrowser client:load posts={summaries} basePath={seriesUrl(series.id)} title={series.data.title} initialPage={page} initialPageSize={pageSize} />
  {pageCount > 1 && <noscript><nav aria-label="专题翻页">
    {page > 1 && <a href={seriesUrl(series.id, page - 1, pageSize)} rel="prev">← 上一页</a>}
    {' · '}
    {page < pageCount && <a href={seriesUrl(series.id, page + 1, pageSize)} rel="next">下一页 →</a>}
  </nav></noscript>}
</BaseLayout>
