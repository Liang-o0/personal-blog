---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
---

<div class="flex items-end justify-between border-b border-zinc-200 pb-3 mb-6">
  <h2 class="text-xl font-bold">{title}</h2>
  {href && <a class="text-sm text-zinc-500 hover:text-zinc-900" href={href}>查看全部 →</a>}
</div>
