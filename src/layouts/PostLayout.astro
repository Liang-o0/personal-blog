---
import BaseLayout from './BaseLayout.astro'
const { frontmatter } = Astro.props
---
<BaseLayout title={`${frontmatter.title} · PWL Journal`} description={frontmatter.description}><article><header><p>{frontmatter.date}</p><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p><div>{frontmatter.tags?.map((tag) => <span>#{tag} </span>)}</div></header><slot /></article></BaseLayout>
