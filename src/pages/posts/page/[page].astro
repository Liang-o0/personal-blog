---
import ArchivePage from '../../../components/posts/ArchivePage.astro';
import { getPostIndex } from '../../../lib/posts';
import { paginateArchive } from '../../../lib/archive-pagination';
export async function getStaticPaths() {
  const { posts } = await getPostIndex();
  const { pageCount } = paginateArchive(posts);
  return Array.from({ length: pageCount - 1 }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2 },
  }));
}
interface Props { page: number }
---
<ArchivePage page={Astro.props.page} />
