---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getPostIndex, postUrl, seriesUrl } from '../../lib/posts';
import WalineComments from '../../components/comments/WalineComments.astro';
import '../../styles/posts.css';
export async function getStaticPaths() {
  const index = await getPostIndex();
  return index.posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content } = await render(post);
const index = await getPostIndex();
const series = post.data.series ? index.seriesById.get(post.data.series.id) : undefined;
const { previous, next } = index.getAdjacentPosts(post);
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { timeZone: 'UTC' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="reading-article">
    <nav class="article-breadcrumbs" aria-label="当前位置">
      <a href="/posts">文章</a>
      {series && <><span aria-hidden="true">/</span><a href={seriesUrl(series.id)}>{series.data.title}</a></>}
      <span aria-hidden="true">/</span><span aria-current="page">{post.data.title}</span>
    </nav>
    {series && <p class="eyebrow article-position">专题阅读 / 第 {post.data.seriesOrder} 篇</p>}
    <h1>{post.data.title}</h1>
    <div class="muted article-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {post.data.updatedDate && <span>更新于 <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>}
      {post.data.tags.map(tag => <span>#{tag}</span>)}
    </div>
    <div class="prose article-content"><Content /></div>
    <WalineComments />
    {series && <a class="article-directory-link" href={seriesUrl(series.id)}>返回专题目录 · {series.data.title} →</a>}
    {(previous || next) && (
      <nav class="article-pagination" aria-label={series ? '专题内文章导航' : '文章导航'}>
        {previous ? <a class="glass" href={postUrl(previous.id)} rel="prev"><small class="eyebrow">上一篇</small><strong>{previous.data.title}</strong></a> : <span />}
        {next ? <a class="glass article-next" href={postUrl(next.id)} rel="next"><small class="eyebrow">下一篇</small><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
